  "humanSetupInstructions": [
    "Create a GameObject 'GameManager' and attach 'GameManager.cs' and 'UIManager.cs'.",
    "Assign UIManager inspector fields: 'scoreText' (TMP), 'coinText' (TMP), 'gameOverUI' (Panel), 'feverText' (TMP), 'feverSlider' (Slider), 'wallTimerText' (TMP), 'nextCoinText' (TMP).",
    "Assign CoinSpawner.cs to a dedicated GameObject and link 'coinPrefab' and 'bumperPrefab' in Inspector.",
    "Attach 'SideWallsController.cs' to a GameObject and provide left/right wall references (or leave null for auto-gen).",
    "Ensure all ScoreZones have a BoxCollider marked as 'Is Trigger' and attached 'ScoreZone.cs'.",
    "Add 'Pusher' GameObject with Rigidbody (Kinematic), 'PusherMovement.cs', and BoxCollider."
